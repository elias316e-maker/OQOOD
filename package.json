{
  "name": "oqood",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@oqood/platform",
    "build": "npm run build --workspace=@oqood/platform",
    "lint": "npm run lint --workspace=@oqood/platform",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "design-system:typecheck": "npm run typecheck --workspace=@oqood/design-system",
    "test": "npm run test --workspace=@oqood/platform",
    "test:integration": "npm run test:integration --workspace=@oqood/platform"
  }
}
