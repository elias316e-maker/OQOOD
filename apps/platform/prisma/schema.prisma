generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum CompanyVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum PartnerRole {
  SUPPLIER
  CONTRACTOR
  CONSULTANT
  MANUFACTURER
  DISTRIBUTOR
  SERVICE_PROVIDER
  LOGISTICS_PROVIDER
  INVESTMENT_PARTNER
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum OpportunityType {
  RFQ
  RFP
  TENDER
  DIRECT_PURCHASE
  SERVICE_REQUEST
  SUBCONTRACT
}

enum OpportunityStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  CLARIFICATION
  SUBMISSION_CLOSED
  TECHNICAL_EVALUATION
  FINANCIAL_EVALUATION
  NEGOTIATION
  AWARD_PENDING
  AWARDED
  CANCELLED
  CLOSED
  ARCHIVED
}

enum OpportunityVisibility {
  PRIVATE
  INVITED
  PUBLIC
}

enum OpportunityCriterionCategory {
  TECHNICAL
  FINANCIAL
  COMMERCIAL
  COMPLIANCE
  DOCUMENT
  CUSTOM
}

enum OpportunityCriterionScoringMethod {
  PASS_FAIL
  NUMERIC
  PERCENTAGE
  MANUAL
}

enum InvitationStatus {
  PENDING
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum OfferStatus {
  DRAFT
  SUBMITTED
  WITHDRAWN
  UNDER_REVIEW
  TECHNICALLY_ACCEPTED
  TECHNICALLY_REJECTED
  FINANCIALLY_EVALUATED
  WINNER
  LOST
}

enum ContractStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT_FOR_SIGNATURE
  ACTIVE
  SUSPENDED
  COMPLETED
  TERMINATED
  CANCELLED
  ARCHIVED
}

enum ContractAmendmentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum ContractMilestoneStatus {
  PLANNED
  IN_PROGRESS
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum MilestonePaymentStatus {
  NOT_CLAIMED
  CLAIMED
  PAID
}

enum ProcurementRequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  CANCELLED
  ARCHIVED
}

enum ProcurementPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ProcurementItemType {
  MATERIAL
  SERVICE
  WORK
}

enum DocumentEntityType {
  WORKSPACE
  PROCUREMENT_REQUEST
  OPPORTUNITY
  OFFER
  CONTRACT
  BUSINESS_PARTNER
  PROJECT
}

enum DocumentReviewStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  EXPIRED
  ARCHIVED
}

enum PlanStatus {
  DRAFT
  ACTIVE
  RETIRED
  ARCHIVED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
  EXPIRED
}

enum WorkspaceAccessState {
  FULL
  RESTRICTED
  READ_ONLY
  BLOCKED
}

enum SubscriptionSource {
  SYSTEM_TRIAL
  CHECKOUT
  MANUAL
  MIGRATION
  PARTNER
}

enum EntitlementValueType {
  BOOLEAN
  INTEGER
  DECIMAL
  STRING
  JSON
}

enum EnforcementMode {
  HARD
  SOFT
  METERED
  INFORMATIONAL
}

enum UsageAggregationType {
  SUM
  COUNT
  MAX
  LAST
}

enum UsageResetPeriod {
  NONE
  DAILY
  MONTHLY
  YEARLY
  BILLING_PERIOD
}

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false)
  emailVerifiedAt  DateTime?
  image            String?
  phone            String?
  isActive         Boolean   @default(true)
  twoFactorEnabled Boolean?  @default(false)

  // حقول توافقية مؤقتة وفق ADR-007.
  // تزال بعد اكتمال Migration والتحقق من البيانات.
  passwordHash String?
  imageUrl     String?

  sessions   Session[]
  accounts   Account[]
  twoFactors TwoFactor[]

  memberships                  WorkspaceMember[]
  createdWorkspaces            Workspace[]              @relation("WorkspaceCreator")
  createdProjects              Project[]                @relation("ProjectCreator")
  createdOpportunities         Opportunity[]            @relation("OpportunityCreator")
  createdContracts             Contract[]               @relation("ContractCreator")
  createdContractAmendments    ContractAmendment[]      @relation("ContractAmendmentCreator")
  approvedContractAmendments   ContractAmendment[]      @relation("ContractAmendmentApprover")
  createdContractMilestones    ContractMilestone[]      @relation("ContractMilestoneCreator")
  createdPartnerEvaluations    PartnerEvaluation[]      @relation("PartnerEvaluationCreator")
  requestedProcurementRequests ProcurementRequest[]     @relation("ProcurementRequestedBy")
  assignedProcurementRequests  ProcurementRequest[]     @relation("ProcurementAssignedTo")
  createdProcurementRequests   ProcurementRequest[]     @relation("ProcurementCreatedBy")
  uploadedDocuments            Document[]               @relation("DocumentUploader")
  reviewedDocuments            Document[]               @relation("DocumentReviewer")
  deletedDocuments             Document[]               @relation("DocumentDeleter")
  notificationReceipts         NotificationReceipt[]
  notificationPreferences      NotificationPreference[]
  notificationDeliveries       NotificationDelivery[]
  sentWorkspaceInvitations     WorkspaceInvitation[]    @relation("WorkspaceInvitationSender")
  acceptedWorkspaceInvitations WorkspaceInvitation[]    @relation("WorkspaceInvitationAcceptor")
  auditLogs                    AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  verified                Boolean   @default(false)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  userId                  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workspace {
  id              String          @id @default(cuid())
  code            String          @unique
  slug            String          @unique
  nameAr          String
  nameEn          String?
  logoUrl         String?
  countryCode     String          @default("SA")
  timezone        String          @default("Asia/Riyadh")
  defaultLanguage String          @default("ar")
  defaultCurrency String          @default("SAR")
  status          WorkspaceStatus @default(DRAFT)

  createdById String
  createdBy   User   @relation("WorkspaceCreator", fields: [createdById], references: [id])

  members                 WorkspaceMember[]
  companies               Company[]
  partners                BusinessPartner[]
  projects                Project[]
  opportunities           Opportunity[]
  contracts               Contract[]
  procurementRequests     ProcurementRequest[]
  documents               Document[]
  notificationReceipts    NotificationReceipt[]
  notificationPreferences NotificationPreference[]
  notificationDeliveries  NotificationDelivery[]
  invitations             WorkspaceInvitation[]
  roles                   Role[]
  auditLogs               AuditLog[]
  billingAccount          BillingAccount?
  subscription            Subscription?
  usageCounters           UsageCounter[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  @@index([createdById])
  @@index([status])
}

model WorkspaceMember {
  id          String           @id @default(cuid())
  workspaceId String
  userId      String
  status      MembershipStatus @default(ACTIVE)

  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles     WorkspaceMemberRole[]

  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, status])
}

model WorkspaceInvitation {
  id           String                    @id @default(cuid())
  workspaceId  String
  email        String
  roleId       String
  tokenHash    String                    @unique
  status       WorkspaceInvitationStatus @default(PENDING)
  invitedById  String
  acceptedById String?
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  invitedBy  User      @relation("WorkspaceInvitationSender", fields: [invitedById], references: [id])
  acceptedBy User?     @relation("WorkspaceInvitationAcceptor", fields: [acceptedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, status])
  @@index([email, status])
  @@index([expiresAt])
}

model Company {
  id                 String                    @id @default(cuid())
  workspaceId        String
  nameAr             String
  nameEn             String?
  commercialRegister String?
  taxNumber          String?
  nationalAddress    String?
  website            String?
  email              String?
  phone              String?
  description        String?
  city               String?
  countryCode        String                    @default("SA")
  verificationStatus CompanyVerificationStatus @default(UNVERIFIED)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  branches  CompanyBranch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, commercialRegister])
  @@index([workspaceId])
  @@index([verificationStatus])
}

model CompanyBranch {
  id           String  @id @default(cuid())
  companyId    String
  nameAr       String
  nameEn       String?
  city         String?
  address      String?
  phone        String?
  email        String?
  isHeadOffice Boolean @default(false)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model BusinessPartner {
  id                 String                    @id @default(cuid())
  workspaceId        String
  nameAr             String
  nameEn             String?
  commercialRegister String?
  taxNumber          String?
  email              String?
  phone              String?
  website            String?
  city               String?
  countryCode        String                    @default("SA")
  trustScore         Decimal?                  @db.Decimal(5, 2)
  verificationStatus CompanyVerificationStatus @default(UNVERIFIED)

  workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  roles       BusinessPartnerRole[]
  invitations OpportunityInvitation[]
  offers      Offer[]
  contracts   Contract[]
  evaluations PartnerEvaluation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, commercialRegister])
  @@index([workspaceId])
  @@index([verificationStatus])
}

model BusinessPartnerRole {
  id                String      @id @default(cuid())
  businessPartnerId String
  role              PartnerRole

  businessPartner BusinessPartner @relation(fields: [businessPartnerId], references: [id], onDelete: Cascade)

  @@unique([businessPartnerId, role])
  @@index([role])
}

model Project {
  id          String        @id @default(cuid())
  workspaceId String
  code        String
  nameAr      String
  nameEn      String?
  description String?
  status      ProjectStatus @default(PLANNED)
  startDate   DateTime?
  endDate     DateTime?
  budget      Decimal?      @db.Decimal(18, 2)
  currency    String        @default("SAR")

  createdById String
  createdBy   User      @relation("ProjectCreator", fields: [createdById], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  opportunities       Opportunity[]
  procurementRequests ProcurementRequest[]
  contracts           Contract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, code])
  @@index([workspaceId, status])
}

model Opportunity {
  id          String                @id @default(cuid())
  workspaceId String
  projectId   String?
  number      String
  title       String
  description String?
  type        OpportunityType
  status      OpportunityStatus     @default(DRAFT)
  visibility  OpportunityVisibility @default(INVITED)
  category    String?
  priority    String                @default("NORMAL")
  budget      Decimal?              @db.Decimal(18, 2)
  currency    String                @default("SAR")
  issueDate   DateTime?
  closingDate DateTime?

  createdById String
  createdBy   User      @relation("OpportunityCreator", fields: [createdById], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  items       OpportunityItem[]
  invitations OpportunityInvitation[]
  offers      Offer[]
  contracts   Contract[]

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  publishedAt           DateTime?
  closedAt              DateTime?
  opportunityCriterions OpportunityCriterion[]

  @@unique([workspaceId, number])
  @@index([workspaceId, status])
  @@index([projectId])
  @@index([closingDate])
}

model OpportunityItem {
  id            String  @id @default(cuid())
  opportunityId String
  lineNumber    Int
  description   String
  quantity      Decimal @db.Decimal(18, 4)
  unit          String
  specification String?
  notes         String?

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  offerItems  OfferItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([opportunityId, lineNumber])
  @@index([opportunityId])
}

model OpportunityCriterion {
  id            String                            @id @default(cuid())
  opportunityId String
  name          String
  description   String?
  category      OpportunityCriterionCategory
  scoringMethod OpportunityCriterionScoringMethod
  weight        Decimal                           @db.Decimal(5, 2)
  minimumScore  Decimal?                          @db.Decimal(5, 2)
  required      Boolean                           @default(false)
  active        Boolean                           @default(true)
  displayOrder  Int                               @default(0)

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([opportunityId, name])
  @@index([opportunityId, active, displayOrder])
  @@index([opportunityId, category])
}

model OpportunityInvitation {
  id                String           @id @default(cuid())
  opportunityId     String
  businessPartnerId String
  status            InvitationStatus @default(PENDING)
  message           String?
  sentAt            DateTime?
  viewedAt          DateTime?
  respondedAt       DateTime?

  opportunity     Opportunity     @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  businessPartner BusinessPartner @relation(fields: [businessPartnerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([opportunityId, businessPartnerId])
  @@index([businessPartnerId, status])
}

model Offer {
  id                String      @id @default(cuid())
  opportunityId     String
  businessPartnerId String
  referenceNumber   String?
  status            OfferStatus @default(DRAFT)
  currency          String      @default("SAR")
  subtotal          Decimal?    @db.Decimal(18, 2)
  taxAmount         Decimal?    @db.Decimal(18, 2)
  totalAmount       Decimal?    @db.Decimal(18, 2)
  validityDays      Int?
  deliveryDays      Int?
  paymentTerms      String?
  technicalNotes    String?
  commercialNotes   String?
  submittedAt       DateTime?

  opportunity     Opportunity     @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  businessPartner BusinessPartner @relation(fields: [businessPartnerId], references: [id], onDelete: Cascade)
  items           OfferItem[]
  contract        Contract?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([opportunityId, businessPartnerId])
  @@index([opportunityId, status])
  @@index([businessPartnerId])
}

model Contract {
  id                String         @id @default(cuid())
  workspaceId       String
  projectId         String?
  opportunityId     String
  sourceOfferId     String         @unique
  businessPartnerId String
  number            String
  title             String
  description       String?
  status            ContractStatus @default(DRAFT)
  currency          String         @default("SAR")
  subtotal          Decimal        @db.Decimal(18, 2)
  taxAmount         Decimal        @db.Decimal(18, 2)
  totalAmount       Decimal        @db.Decimal(18, 2)
  paymentTerms      String?
  deliveryDays      Int?
  startDate         DateTime?
  endDate           DateTime?
  suspendedAt       DateTime?
  suspensionReason  String?
  completedAt       DateTime?
  terminatedAt      DateTime?
  terminationReason String?
  createdById       String

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project            Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  opportunity        Opportunity         @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  sourceOffer        Offer               @relation(fields: [sourceOfferId], references: [id], onDelete: Restrict)
  businessPartner    BusinessPartner     @relation(fields: [businessPartnerId], references: [id], onDelete: Restrict)
  createdBy          User                @relation("ContractCreator", fields: [createdById], references: [id])
  items              ContractItem[]
  amendments         ContractAmendment[]
  milestones         ContractMilestone[]
  partnerEvaluations PartnerEvaluation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, number])
  @@index([workspaceId, status])
  @@index([opportunityId])
  @@index([businessPartnerId])
}

model PartnerEvaluation {
  id                  String  @id @default(cuid())
  contractId          String
  businessPartnerId   String
  timelinessScore     Int
  qualityScore        Int
  responsivenessScore Int
  financialScore      Int
  overallScore        Decimal @db.Decimal(5, 2)
  notes               String?
  createdById         String

  contract        Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  businessPartner BusinessPartner @relation(fields: [businessPartnerId], references: [id], onDelete: Cascade)
  createdBy       User            @relation("PartnerEvaluationCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([contractId, createdAt])
  @@index([businessPartnerId, createdAt])
}

model ContractMilestone {
  id              String                  @id @default(cuid())
  contractId      String
  number          Int
  title           String
  description     String?
  dueDate         DateTime?
  amount          Decimal                 @default(0) @db.Decimal(18, 2)
  progress        Int                     @default(0)
  status          ContractMilestoneStatus @default(PLANNED)
  paymentStatus   MilestonePaymentStatus  @default(NOT_CLAIMED)
  createdById     String
  startedAt       DateTime?
  submittedAt     DateTime?
  acceptedAt      DateTime?
  claimedAt       DateTime?
  paidAt          DateTime?
  rejectionReason String?

  contract  Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdBy User     @relation("ContractMilestoneCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractId, number])
  @@index([contractId, status])
  @@index([contractId, paymentStatus])
}

model ContractAmendment {
  id               String                  @id @default(cuid())
  contractId       String
  number           Int
  title            String
  reason           String
  status           ContractAmendmentStatus @default(DRAFT)
  valueChange      Decimal                 @default(0) @db.Decimal(18, 2)
  previousTotal    Decimal                 @db.Decimal(18, 2)
  resultingTotal   Decimal                 @db.Decimal(18, 2)
  previousEndDate  DateTime?
  newEndDate       DateTime?
  contractSnapshot Json
  createdById      String
  approvedById     String?
  submittedAt      DateTime?
  approvedAt       DateTime?
  rejectionReason  String?

  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdBy  User     @relation("ContractAmendmentCreator", fields: [createdById], references: [id])
  approvedBy User?    @relation("ContractAmendmentApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractId, number])
  @@index([contractId, status])
}

model ContractItem {
  id          String  @id @default(cuid())
  contractId  String
  lineNumber  Int
  description String
  quantity    Decimal @db.Decimal(18, 4)
  unit        String
  unitPrice   Decimal @db.Decimal(18, 4)
  totalPrice  Decimal @db.Decimal(18, 2)
  notes       String?

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractId, lineNumber])
  @@index([contractId])
}

model OfferItem {
  id                String  @id @default(cuid())
  offerId           String
  opportunityItemId String
  unitPrice         Decimal @db.Decimal(18, 4)
  quantity          Decimal @db.Decimal(18, 4)
  totalPrice        Decimal @db.Decimal(18, 2)
  notes             String?

  offer           Offer           @relation(fields: [offerId], references: [id], onDelete: Cascade)
  opportunityItem OpportunityItem @relation(fields: [opportunityItemId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([offerId, opportunityItemId])
  @@index([opportunityItemId])
}

model Role {
  id          String  @id @default(cuid())
  workspaceId String
  code        String
  name        String
  description String?
  isSystem    Boolean @default(false)

  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     WorkspaceMemberRole[]
  permissions RolePermission[]
  invitations WorkspaceInvitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, code])
}

model Permission {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkspaceMemberRole {
  id                String @id @default(cuid())
  workspaceMemberId String
  roleId            String

  workspaceMember WorkspaceMember @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)
  role            Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([workspaceMemberId, roleId])
  @@index([roleId])
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model Plan {
  id             String     @id @default(cuid())
  code           String
  version        Int
  nameAr         String
  nameEn         String?
  description    String?
  status         PlanStatus @default(DRAFT)
  isDefaultTrial Boolean    @default(false)
  trialDays      Int
  metadata       Json?

  prices        PlanPrice[]
  entitlements  PlanEntitlement[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code, version])
  @@index([status])
  @@index([isDefaultTrial, status])
}

model PlanPrice {
  id              String          @id @default(cuid())
  planId          String
  billingInterval BillingInterval
  amount          Decimal         @db.Decimal(18, 2)
  currency        String
  isActive        Boolean         @default(true)
  metadata        Json?

  plan          Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, billingInterval, currency])
  @@index([planId, isActive])
}

model BillingAccount {
  id                 String  @id @default(cuid())
  workspaceId        String  @unique
  legalName          String
  billingEmail       String?
  countryCode        String
  currency           String
  language           String
  taxNumber          String?
  commercialRegister String?
  metadata           Json?

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id                    String               @id @default(cuid())
  workspaceId           String               @unique
  billingAccountId      String
  planId                String
  planPriceId           String?
  initializationKey     String               @unique
  status                SubscriptionStatus
  accessState           WorkspaceAccessState
  source                SubscriptionSource
  trialStartsAt         DateTime?
  trialEndsAt           DateTime?
  currentPeriodStartsAt DateTime
  currentPeriodEndsAt   DateTime
  canceledAt            DateTime?
  endedAt               DateTime?
  metadata              Json?

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Restrict)
  plan           Plan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  planPrice      PlanPrice?     @relation(fields: [planPriceId], references: [id], onDelete: SetNull)
  usageCounters  UsageCounter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([billingAccountId])
  @@index([planId])
  @@index([status, accessState])
  @@index([trialEndsAt])
}

model FeatureDefinition {
  id           String               @id @default(cuid())
  key          String               @unique
  name         String
  description  String?
  valueType    EntitlementValueType
  defaultValue Json?
  isActive     Boolean              @default(true)

  entitlements PlanEntitlement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model PlanEntitlement {
  id              String          @id @default(cuid())
  planId          String
  featureId       String
  value           Json
  enforcementMode EnforcementMode
  metadata        Json?

  plan    Plan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature FeatureDefinition @relation(fields: [featureId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, featureId])
  @@index([featureId])
}

model UsageMeter {
  id              String               @id @default(cuid())
  code            String               @unique
  name            String
  description     String?
  aggregationType UsageAggregationType
  resetPeriod     UsageResetPeriod
  initialValue    Decimal              @default(0) @db.Decimal(30, 6)
  isActive        Boolean              @default(true)
  metadata        Json?

  counters UsageCounter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model UsageCounter {
  id             String   @id @default(cuid())
  workspaceId    String
  subscriptionId String
  meterId        String
  periodKey      String
  periodStartsAt DateTime
  periodEndsAt   DateTime
  value          Decimal  @default(0) @db.Decimal(30, 6)
  metadata       Json?

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  meter        UsageMeter   @relation(fields: [meterId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subscriptionId, meterId, periodKey])
  @@index([workspaceId])
  @@index([meterId])
  @@index([periodStartsAt, periodEndsAt])
}

model AuditLog {
  id          String  @id @default(cuid())
  workspaceId String
  userId      String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
  @@index([userId])
}

model ProcurementRequest {
  id             String                   @id @default(cuid())
  workspaceId    String
  projectId      String?
  number         String
  title          String
  description    String?
  status         ProcurementRequestStatus @default(DRAFT)
  priority       ProcurementPriority      @default(NORMAL)
  category       String?
  requiredByDate DateTime?
  currency       String                   @default("SAR")
  estimatedTotal Decimal?                 @db.Decimal(18, 2)
  requestedById  String
  assignedToId   String?
  createdById    String
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  requestedBy User      @relation("ProcurementRequestedBy", fields: [requestedById], references: [id])
  assignedTo  User?     @relation("ProcurementAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy   User      @relation("ProcurementCreatedBy", fields: [createdById], references: [id])

  items ProcurementRequestItem[]

  @@unique([workspaceId, number])
  @@index([workspaceId, status])
  @@index([workspaceId, priority])
  @@index([createdById])
  @@index([requiredByDate])
  @@index([projectId])
  @@index([requestedById])
  @@index([assignedToId])
}

model ProcurementRequestItem {
  id                   String              @id @default(cuid())
  procurementRequestId String
  lineNumber           Int
  type                 ProcurementItemType
  description          String
  quantity             Decimal             @db.Decimal(18, 4)
  unit                 String
  specification        String?
  estimatedUnitPrice   Decimal?            @db.Decimal(18, 4)
  estimatedTotal       Decimal?            @db.Decimal(18, 2)
  requiredByDate       DateTime?
  deliveryLocation     String?
  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  procurementRequest ProcurementRequest @relation(fields: [procurementRequestId], references: [id], onDelete: Cascade)

  @@unique([procurementRequestId, lineNumber])
  @@index([procurementRequestId])
}

model Document {
  id                String               @id @default(cuid())
  workspaceId       String
  entityType        DocumentEntityType
  entityId          String?
  title             String
  category          String
  fileName          String
  mimeType          String
  storageKey        String               @unique
  sizeBytes         BigInt
  version           Int                  @default(1)
  reviewStatus      DocumentReviewStatus @default(DRAFT)
  isConfidential    Boolean              @default(false)
  expiresAt         DateTime?
  notes             String?
  uploadedById      String
  reviewedById      String?
  reviewedAt        DateTime?
  reviewNotes       String?
  previousVersionId String?              @unique
  deletedById       String?
  deletedAt         DateTime?
  deletionReason    String?

  workspace       Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy      User       @relation("DocumentUploader", fields: [uploadedById], references: [id])
  reviewedBy      User?      @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  deletedBy       User?      @relation("DocumentDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  previousVersion Document?  @relation("DocumentVersions", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersions    Document[] @relation("DocumentVersions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, entityType, entityId])
  @@index([workspaceId, reviewStatus])
  @@index([workspaceId, category])
  @@index([expiresAt])
  @@index([reviewedById])
  @@index([previousVersionId])
  @@index([deletedById])
  @@index([workspaceId, deletedAt])
}

model NotificationReceipt {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  fingerprint String
  readAt      DateTime?
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, fingerprint])
  @@index([workspaceId, userId, readAt])
  @@index([workspaceId, userId, dismissedAt])
}

model NotificationPreference {
  id           String  @id @default(cuid())
  workspaceId  String
  userId       String
  category     String
  inAppEnabled Boolean @default(true)
  emailEnabled Boolean @default(true)
  digest       String  @default("IMMEDIATE")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, userId, category])
  @@index([userId, emailEnabled])
}

model NotificationDelivery {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String?
  category    String
  channel     String
  recipient   String
  subject     String
  body        String
  href        String?
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  providerId  String?
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledAt])
  @@index([workspaceId, category])
  @@index([userId, createdAt])
}
