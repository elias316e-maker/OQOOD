# PostgreSQL
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST/DATABASE?sslmode=require"
DIRECT_DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST/DATABASE?sslmode=require"

# Better Auth
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-secure-random-secret"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated HTTPS origins allowed to submit Server Actions in production.
# Example: https://app.oqood.sa,https://admin.oqood.sa
APP_ALLOWED_ORIGINS=""

# Production must point this to a persistent mounted volume.
DOCUMENT_STORAGE_ROOT="/var/lib/oqood/documents"
